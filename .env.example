# Copy this file to .env and add your own values.
#
#   cp .env.example .env
#
# Every variable below is read by backend/src/config/env.js. Nothing else is
# read from the environment, so this list is complete.
#
# The application runs WITHOUT any secret in demo mode: the pages, the database
# and the four healthcare modules all work. What is unavailable without a
# Groq key is the AI itself - the chat, the report explanation and the visit
# summary return HTTP 503 and the interface shows an honest fallback instead.
# In production the app refuses to boot without GROQ_API_KEY.


# ---------------------------------------------------------------- runtime ----
# Required. 'development' | 'production' | 'test'.
# 'test' skips dotenv and lifts the rate limits.
NODE_ENV=development

# Required. Port the Express server listens on.
PORT=3000


# ------------------------------------------------------------ AI provider ----
# Groq is the only AI provider in this project.
#
# Required for the AI features. Without it the app still starts and every
# AI-backed endpoint answers 503 with a "not configured" message.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. The text model used for the chat, the report explanation and the
# visit summary. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. A vision model, used ONLY to read text out of image or scanned-PDF
# reports. Leave blank if you only upload text PDFs - those are parsed with
# pdf-parse and need no AI at all. Without it, image uploads are stored but
# nothing can be read out of them, and the page offers manual entry instead.
GROQ_VISION_MODEL=

# Optional. Timeout per attempt, in milliseconds (5000-120000). Default 30000.
GROQ_TIMEOUT_MS=30000

# Optional. Retries for transient provider or network errors (0-3). Default 2.
GROQ_MAX_RETRIES=2


# --------------------------------------------------------------- database ----
# Required for every feature that stores data. Without it the app still boots
# and the pages render, but anything that reads or writes records fails with
# a clear "database is not configured" message.
#
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amar_doctor


# ------------------------------------------------------------------ http ----
# Optional. Comma-separated list of allowed browser origins.
# Defaults to http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

# Optional. How long a sign-in session stays valid, in days (1-365).
# Default 30.
SESSION_TTL_DAYS=30

# Optional. Largest accepted upload, in bytes (1024-20971520). Default 8 MB.
UPLOAD_MAX_BYTES=8388608


# ------------------------------------------------------------- reminders ----
# Optional. Web-push (VAP) keys. With these set, medicine reminders can be
# pushed to the device even when the app is closed. Without them the app
# falls back to in-app notifications and says so honestly - it never claims a
# reminder was sent when it was not.
VAP_PUBLIC_KEY=
VAP_PRIVATE_KEY=
VAP_SUBJECT=mailto:support@amar-doctor.example

# Optional. Shared secret for the reminder dispatch endpoint that the Vercel
# cron calls. The endpoint returns 503 while this is unset, so a deployed
# cron never fires silently.
CRON_SECRET=


# -------------------------------------------------------------- emergency ----
# Optional. Which emergency number set to use. 'bd' is the only one that
# ships today (999 for ambulance, fire and police). Default 'bd'.
EMERGENCY_REGION=bd


# ----------------------------------------------------------- rate limits ----
# Optional. Requests per 15 minutes. Defaults in brackets. The limits are
# lifted entirely when NODE_ENV=test.
API_RATE_LIMIT=300         # every /api route          [300]
CHAT_RATE_LIMIT=10         # POST /api/chat, per minute[10]
AUTH_RATE_LIMIT=10         # register and login       [10]
SESSION_RATE_LIMIT=300     # GET /api/auth/me         [300]
UPLOAD_RATE_LIMIT=20       # report uploads           [20]


# ----------------------------------------------------------------- tests ----
# Optional, test-only. The test suite creates an isolated schema per test
# file and drops it afterwards. Without this variable (or DATABASE_URL) the
# database-backed tests SKIP rather than fail, so a green run on its own is
# not evidence that they passed.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amar_doctor
